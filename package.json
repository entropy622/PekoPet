{
  "name": "pekopet",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/launch-electron.mjs",
    "build": "node scripts/build-electron.mjs",
    "check:ui": "node scripts/check-ui.mjs",
    "test": "node --test tests/*.test.mjs",
    "assets": "node scripts/fetch-models.mjs",
    "package:windows": "node scripts/package-electron.mjs",
    "build:frontend": "node scripts/build-frontend.mjs",
    "start:agent": "node scripts/start-agent.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.renderer.json",
    "check:avatar": "node scripts/check-avatar-behavior.mjs"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/cordis-plugin-include": "1.0.10",
    "@deepseek-ai/dsh-app-boot": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-atomic-write": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-attachment": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-base": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-brand": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-client-ui-chat": "file:vendor/dsh-ui-chat",
    "@deepseek-ai/dsh-client-ui-conversation": "file:vendor/dsh-ui-conversation",
    "@deepseek-ai/dsh-llm": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-llm-deepseek-api-key": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-mcp-client": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-scope": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-sdk-protocol": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-web-app": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-web-frontend": "0.2.1-alpha.4",
    "js-yaml": "4.3.2",
    "yaml": "2.8.2"
  },
  "allowScripts": {
    "@deepseek-ai/dsh-subprocess-local@0.2.1-alpha.4": true,
    "koffi@3.1.1": true,
    "node-pty@1.2.0-beta.15": true,
    "protobufjs@7.6.6": true,
    "esbuild@0.28.2": true,
    "electron@45.3.0": true
  },
  "devDependencies": {
    "@lexical/headless": "0.49.0",
    "@lexical/history": "0.49.0",
    "@lexical/plain-text": "0.49.0",
    "@lexical/text": "0.49.0",
    "@lexical/utils": "0.49.0",
    "@playwright/test": "1.65.0",
    "@types/node": "24.10.1",
    "clsx": "2.1.1",
    "electron": "45.3.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "lexical": "0.49.0",
    "pngjs": "7.0.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@deepseek-ai/dsh-client-ui-chat": "$@deepseek-ai/dsh-client-ui-chat",
    "@deepseek-ai/dsh-client-ui-conversation": "$@deepseek-ai/dsh-client-ui-conversation"
  },
  "main": "build/electron/main.cjs",
  "description": "PekoPet desktop companion",
  "author": "entropy622",
  "license": "MIT"
}
